#!/bin/sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell >/dev/null 2>&1; then
    powershell_command=powershell
else
    printf '%s\n' "pre-push checks require PowerShell (pwsh or powershell)." >&2
    exit 1
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -Command - <<'POWERSHELL'
$args = @()

$ErrorActionPreference = 'Stop'
$repoRoot = (& git rev-parse --show-toplevel).Trim()
if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($repoRoot)) {
    throw 'Unable to locate the repository root.'
}

function Invoke-CheckedCommand {
    param(
        [Parameter(Mandatory)] [string] $Command,
        [Parameter(Mandatory)] [string[]] $Arguments,
        [Parameter(Mandatory)] [string] $WorkingDirectory
    )

    Write-Host "`n> $Command $($Arguments -join ' ')"
    Push-Location $WorkingDirectory
    try {
        & $Command @Arguments
        if ($LASTEXITCODE -ne 0) { throw "$Command exited with code $LASTEXITCODE." }
    }
    finally { Pop-Location }
}

if (-not (Get-Command dotnet -ErrorAction SilentlyContinue)) { throw 'The pre-push checks require dotnet on PATH.' }
if (-not (Get-Command npm -ErrorAction SilentlyContinue)) { throw 'The pre-push checks require npm on PATH.' }

$coverageRoot = Join-Path $repoRoot ('TestResults/pre-push/' + [guid]::NewGuid().ToString('N'))
Write-Host "Coverage reports: $coverageRoot"
New-Item -ItemType Directory -Path $coverageRoot -Force | Out-Null

try {
    $changedCliFiles = @(git diff --name-only 'origin/main...HEAD' -- '*.cs' '*.csproj' '*.props' '*.targets')
    foreach ($file in @($changedCliFiles | Where-Object { $_ -like 'cli/*.cs' })) {
        $bytes = [System.IO.File]::ReadAllBytes((Join-Path $repoRoot $file))
        if ($bytes.Length -lt 3 -or $bytes[0] -ne 0xEF -or $bytes[1] -ne 0xBB -or $bytes[2] -ne 0xBF) {
            throw "C# file '$file' must be UTF-8 with BOM, matching cli/.editorconfig."
        }
    }

    Invoke-CheckedCommand dotnet @(
        'build', 'cli/SyncSql.slnx', '--configuration', 'Release', '--no-restore', '-m:1'
    ) $repoRoot

    Invoke-CheckedCommand dotnet @(
        'test', 'cli/SyncSql.slnx', '--configuration', 'Release', '--no-restore', '--no-build', '-m:1',
        '--collect', 'XPlat Code Coverage', '--settings', 'cli/coverage.runsettings',
        '--results-directory', $coverageRoot, '--logger', 'console;verbosity=minimal'
    ) $repoRoot

    $reports = @(Get-ChildItem -LiteralPath $coverageRoot -Recurse -Filter 'coverage.cobertura.xml' -File)
    if ($reports.Count -eq 0) { throw 'CLI tests completed without producing a Cobertura coverage report.' }

    # Use CI's pinned ReportGenerator merge, then enforce its exact raw counts.
    Invoke-CheckedCommand dotnet @('tool', 'restore') $repoRoot
    Invoke-CheckedCommand dotnet @(
        'tool', 'run', 'reportgenerator',
        "-reports:$coverageRoot/**/coverage.cobertura.xml",
        "-targetdir:$coverageRoot/report",
        '-reporttypes:Html;Cobertura;JsonSummary'
    ) $repoRoot
    & (Join-Path $repoRoot 'scripts/Assert-CliCoverage.ps1') -SummaryPath (Join-Path $coverageRoot 'report/Summary.json')
    $sitePath = Join-Path $repoRoot 'site'
    if (-not (Test-Path -LiteralPath (Join-Path $sitePath 'node_modules'))) {
        throw 'Site dependencies are missing. Run npm ci in site/ before pushing.'
    }
    if ($IsWindows) {
        # Match CI's formatting check while accepting the checkout's native line
        # endings. CI still enforces the repository's LF setting on Linux.
        Invoke-CheckedCommand npm @('run', 'format:check', '--', '--end-of-line', 'auto') $sitePath
    }
    else {
        Invoke-CheckedCommand npm @('run', 'format:check') $sitePath
    }
    Invoke-CheckedCommand npm @('run', 'lint') $sitePath
    Invoke-CheckedCommand npm @('run', 'typecheck') $sitePath
    Invoke-CheckedCommand npm @('run', 'test:coverage') $sitePath
}
finally {
    Write-Host "Coverage reports: $coverageRoot"
}

POWERSHELL

if ! command -v git-lfs >/dev/null 2>&1; then
    printf '%s\n' "This repository requires Git LFS, but git-lfs was not found on PATH." >&2
    exit 2
fi
git lfs pre-push "$@"
