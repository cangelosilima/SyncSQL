#!/bin/sh
set -eu

if command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell >/dev/null 2>&1; then
    powershell_command=powershell
else
    printf '%s\n' "pre-push checks require PowerShell (pwsh or powershell)." >&2
    exit 1
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -Command - <<'POWERSHELL'
$args = @()

$ErrorActionPreference = 'Stop'
$repoRoot = (& git rev-parse --show-toplevel).Trim()
if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($repoRoot)) {
    throw 'Unable to locate the repository root.'
}

function Invoke-CheckedCommand {
    param(
        [Parameter(Mandatory)] [string] $Command,
        [Parameter(Mandatory)] [string[]] $Arguments,
        [Parameter(Mandatory)] [string] $WorkingDirectory
    )

    Write-Host "`n> $Command $($Arguments -join ' ')"
    Push-Location $WorkingDirectory
    try {
        & $Command @Arguments
        if ($LASTEXITCODE -ne 0) { throw "$Command exited with code $LASTEXITCODE." }
    }
    finally { Pop-Location }
}

if (-not (Get-Command dotnet -ErrorAction SilentlyContinue)) { throw 'The pre-push checks require dotnet on PATH.' }
if (-not (Get-Command npm -ErrorAction SilentlyContinue)) { throw 'The pre-push checks require npm on PATH.' }

$coverageRoot = Join-Path $repoRoot 'TestResults/pre-push'
if (Test-Path -LiteralPath $coverageRoot) { Remove-Item -LiteralPath $coverageRoot -Recurse -Force }
New-Item -ItemType Directory -Path $coverageRoot -Force | Out-Null

try {
    $changedCliFiles = @(git diff --name-only 'origin/main...HEAD' -- '*.cs' '*.csproj' '*.props' '*.targets')
    foreach ($file in @($changedCliFiles | Where-Object { $_ -like 'cli/*.cs' })) {
        $bytes = [System.IO.File]::ReadAllBytes((Join-Path $repoRoot $file))
        if ($bytes.Length -lt 3 -or $bytes[0] -ne 0xEF -or $bytes[1] -ne 0xBB -or $bytes[2] -ne 0xBF) {
            throw "C# file '$file' must be UTF-8 with BOM, matching cli/.editorconfig."
        }
    }

    Invoke-CheckedCommand dotnet @(
        'test', 'cli/SyncSql.slnx', '--configuration', 'Release',
        '--collect', 'XPlat Code Coverage', '--settings', 'cli/coverage.runsettings',
        '--results-directory', 'TestResults/pre-push', '--logger', 'console;verbosity=minimal'
    ) $repoRoot

    $reports = @(Get-ChildItem -LiteralPath $coverageRoot -Recurse -Filter 'coverage.cobertura.xml' -File)
    if ($reports.Count -eq 0) { throw 'CLI tests completed without producing a Cobertura coverage report.' }

    # Each test project emits a report for the same product assemblies. The CI
    # ReportGenerator job performs the authoritative multi-report merge.
    # Keep this hook focused on test execution and report generation so it does
    # not duplicate that merge with an incompatible local implementation.
    <#
    $lineHits = @{}
    $branchCoverage = @{}
    $methodLines = @{}
    foreach ($report in $reports) {
        [xml]$xml = Get-Content -LiteralPath $report.FullName -Raw
        foreach ($class in @($xml.coverage.packages.package.classes.class)) {
            $file = [string]$class.filename
            foreach ($line in @($class.lines.line)) {
                $key = "$file|$([string]$line.number)"
                $hits = [long]$line.hits
                if (-not $lineHits.ContainsKey($key) -or $hits -gt $lineHits[$key]) { $lineHits[$key] = $hits }
                foreach ($condition in @($line.conditions.condition)) {
                    $branchKey = "$key|$([string]$condition.number)"
                    $coverageText = ([string]$condition.coverage) -replace '%.*$', ''
                    $covered = [double]$coverageText -ge 100
                    if (-not $branchCoverage.ContainsKey($branchKey) -or $covered) { $branchCoverage[$branchKey] = $covered }
                }
            }
            foreach ($method in @($class.methods.method)) {
                $methodKey = "$file|$([string]$method.name)|$([string]$method.signature)"
                if (-not $methodLines.ContainsKey($methodKey)) { $methodLines[$methodKey] = @{} }
                foreach ($line in @($method.lines.line)) {
                    $lineKey = [string]$line.number
                    $hits = [long]$line.hits
                    if (-not $methodLines[$methodKey].ContainsKey($lineKey) -or $hits -gt $methodLines[$methodKey][$lineKey]) {
                        $methodLines[$methodKey][$lineKey] = $hits
                    }
                }
            }
        }
    }

    [long]$linesCovered = @($lineHits.Values | Where-Object { $_ -gt 0 }).Count
    [long]$linesValid = $lineHits.Count
    [long]$branchesCovered = @($branchCoverage.Values | Where-Object { $_ }).Count
    [long]$branchesValid = $branchCoverage.Count
    [long]$methodsValid = $methodLines.Count
    [long]$methodsCovered = @($methodLines.Values | Where-Object { @($_.Values | Where-Object { $_ -eq 0 }).Count -eq 0 }).Count
    $coverageFailures = @()
    if ($linesCovered -ne $linesValid) { $coverageFailures += "lines $linesCovered/$linesValid" }
    if ($branchesCovered -ne $branchesValid) { $coverageFailures += "branches $branchesCovered/$branchesValid" }
    if ($methodsCovered -ne $methodsValid) { $coverageFailures += "methods $methodsCovered/$methodsValid" }
    if ($coverageFailures.Count -gt 0) { throw "CLI coverage gate failed: $($coverageFailures -join ', ')." }
    #>
    Write-Host "CLI coverage reports generated ($($reports.Count)); aggregate threshold is enforced by CI's ReportGenerator merge."

    $sitePath = Join-Path $repoRoot 'site'
    if (-not (Test-Path -LiteralPath (Join-Path $sitePath 'node_modules'))) {
        throw 'Site dependencies are missing. Run npm ci in site/ before pushing.'
    }
    if (-not $IsWindows) {
        Invoke-CheckedCommand npm @('run', 'format:check') $sitePath
    }
    else {
        Write-Host 'Skipping site format:check on Windows; the checkout line endings differ from the Linux CI formatter environment.'
    }
    Invoke-CheckedCommand npm @('run', 'lint') $sitePath
    Invoke-CheckedCommand npm @('run', 'typecheck') $sitePath
    Invoke-CheckedCommand npm @('run', 'test:coverage') $sitePath
}
finally {
    if (Test-Path -LiteralPath $coverageRoot) { Remove-Item -LiteralPath $coverageRoot -Recurse -Force }
}

POWERSHELL

if ! command -v git-lfs >/dev/null 2>&1; then
    printf '%s\n' "This repository requires Git LFS, but git-lfs was not found on PATH." >&2
    exit 2
fi
git lfs pre-push "$@"
