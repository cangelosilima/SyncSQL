# Local extraction output when running `syncsql sync --skip-git`
staging/
*.staging/

# CI artifact directories created by `syncsql sync` / `syncsql catalog build`
/extracted-objects/
/catalog/

# React catalog/lineage site
site/node_modules/
site/dist/
site/*.tsbuildinfo

# .NET CLI build output
cli/**/bin/
cli/**/obj/
cli/**/*.nupkg
cli/nupkg/

# Prebuilt PL/SQL parser package build output. The generated lexer/parser lands in obj/
# and is never committed - it ships only inside the published SyncSql.Grammar.PlSql package.
grammar/**/bin/
grammar/**/obj/
grammar/**/*.nupkg
/nupkg/

# ANTLR4 tool jar cache, when AntlrToolJarDir points here (the grammar-publish job sets it -
# see .gitlab/ci/grammar.yml; locally it defaults to ~/.m2 instead)
/.antlr/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.iml
*.dbmdl
*.jfm
*.psess
*.vsp
*.vspx
*.pidb
*.svclog
*.VC.db
*.VC.VC.opendb
.builds/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# .NET / MSBuild output that isn't under cli/ or grammar/ (test results, publish
# profiles, restore leftovers, crash dumps)
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info
*.trx
*.binlog
*.nuget.props
*.nuget.targets
PublishProfiles/
*.pubxml.user

# Node / npm / pnpm / yarn
node_modules/
dist/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
.eslintcache
.vite/
.turbo/
.cache/

# Local environment overrides - never commit credentials
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
