# Local extraction output when running `syncsql sync --skip-git`
staging/
*.staging/

# CI artifact directories created by `syncsql sync` / `syncsql catalog build`
/extracted-objects/
/catalog/

# React catalog/lineage site
site/node_modules/
site/dist/
site/*.tsbuildinfo

# .NET CLI build output
cli/**/bin/
cli/**/obj/
cli/**/*.nupkg
cli/nupkg/

# Prebuilt PL/SQL parser package build output. The generated lexer/parser lands in obj/
# and is never committed - it ships only inside the published SyncSql.Grammar.PlSql package.
grammar/**/bin/
grammar/**/obj/
grammar/**/*.nupkg
/nupkg/

# ANTLR4 tool jar cache, when AntlrToolJarDir points here (the grammar-publish job sets it -
# see .gitlab/ci/grammar.yml; locally it defaults to ~/.m2 instead)
/.antlr/
