# Local extraction output when running `syncsql sync --skip-git`
staging/
*.staging/

# CI artifact directories created by `syncsql sync` / `syncsql catalog build`
/extracted-objects/
/catalog/

# React catalog/lineage site
site/node_modules/
site/dist/
site/*.tsbuildinfo

# .NET CLI build output
cli/**/bin/
cli/**/obj/
cli/**/*.nupkg
cli/nupkg/

# ANTLR4 tool jar cache, when AntlrToolJarDir points here (the CI jobs set it - see
# .gitlab/ci/cli.yml; locally it defaults to ~/.m2 instead)
/.antlr/
