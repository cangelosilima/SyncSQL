# Default local output root for `syncsql sync` / `metrics update` / `catalog build`
# (--output-root), plus the older hand-picked staging directories.
syncsql-output/
staging/
*.staging/

# CI artifact directories created by `syncsql sync` / `syncsql catalog build`
/extracted-objects/
/metrics-snapshot/
/catalog/

# Local credentials file for `syncsql sync --credentials-file` - never commit one
*credentials*.json

# React catalog/lineage site
site/node_modules/
site/dist/
site/*.tsbuildinfo

# .NET CLI build output
cli/**/bin/
cli/**/obj/
cli/**/*.nupkg
cli/nupkg/

# PL/SQL parser project build output. Generated/*.cs is intentionally versioned so compiling the
# complete Oracle grammar never requires the ANTLR generator or Java.
grammar/**/bin/
grammar/**/obj/
grammar/**/*.nupkg
grammar/**/Generated/*.interp
grammar/**/Generated/*.tokens
/nupkg/

# Visual Studio / Rider / VS Code
.vs/
.idea/

# VS Code: ignore per-user state, but keep the shared workspace config that
# points the C# Dev Kit at cli/SyncSql.slnx and Vitest at site/ - without it
# neither Test Explorer finds any tests (the solution isn't at the repo root).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.iml
*.dbmdl
*.jfm
*.psess
*.vsp
*.vspx
*.pidb
*.svclog
*.VC.db
*.VC.VC.opendb
.builds/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# .NET / MSBuild output that isn't under cli/ or grammar/ (test results, publish
# profiles, restore leftovers, crash dumps)
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info
*.trx
*.binlog
*.nuget.props
*.nuget.targets
PublishProfiles/
*.pubxml.user

# Node / npm / pnpm / yarn
node_modules/
dist/
.npm/
.npm-cache/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
.eslintcache
.vite/
.turbo/
.cache/

# Local environment overrides - never commit credentials
.env
.env.*
!.env.example

# OS cruft
.DS_Store
Thumbs.db
