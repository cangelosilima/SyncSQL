# Copy to samples/.env and edit. samples/.env is git-ignored.
#
#   cp samples/docker/.env.example samples/.env
#
# These are throwaway credentials for throwaway containers full of public sample
# data. Do not reuse them anywhere that matters.

# --- Microsoft SQL Server ----------------------------------------------------
# Must satisfy the SQL Server password policy: 8+ characters, three of upper,
# lower, digit, symbol. The container refuses to start otherwise.
MSSQL_SA_PASSWORD=SyncSql_Samples#2024
# Host port. Defaults to 14330 rather than 1433 so a local SQL Server instance
# keeps working. Change it and samples/config/servers.samples.json must match.
MSSQL_PORT=14330
MSSQL_PID=Developer
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_TOOLS_IMAGE=mcr.microsoft.com/mssql-tools:latest

# --- Oracle Database Free ----------------------------------------------------
# Password for SYS, SYSTEM and PDBADMIN. SyncSQL connects as SYSTEM.
ORACLE_PASSWORD=SyncSql_Samples_2024
# Password given to the HR / CO / SH schema users the install scripts create.
ORACLE_SAMPLE_PASSWORD=SyncSql_Samples_2024
# Host port. Defaults to 15210 rather than 1521 for the same reason as above.
ORACLE_PORT=15210
ORACLE_IMAGE=gvenzl/oracle-free:23-slim
