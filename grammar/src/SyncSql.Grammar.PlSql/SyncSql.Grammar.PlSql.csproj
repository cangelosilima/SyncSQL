<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PL/SQL lexer/parser, packaged.

    This project is deliberately NOT part of cli/SyncSql.slnx. It is the only thing in the
    repository that runs the ANTLR4 tool (a Java program) and it is built by hand, roughly never -
    only when Grammar/*.g4 changes. What it produces is an ordinary NuGet package on the Nexus
    feed; cli/src/SyncSql.Lineage.Oracle consumes that package like any other dependency, so
    `dotnet build cli/SyncSql.slnx` needs nothing but the .NET SDK. No Java, no jar, and no
    generated code anywhere in source control.

    Publishing a new version: see ../../README.md in this folder's parent.
  -->

  <PropertyGroup>
    <!-- Single source of truth for the ANTLR version: the runtime package below and the Java
         tool jar AntlrTool.targets resolves have to be the same version, or Antlr4BuildTasks
         refuses to run. Declared before the import below, which reads it. -->
    <AntlrVersion>4.13.1</AntlrVersion>
  </PropertyGroup>

  <!-- Resolves the ANTLR4 tool jar (and checks for a JRE) before the codegen below runs.
       See that file's header for the overrides available on an offline/mirrored build. -->
  <Import Project="AntlrTool.targets" />

  <PropertyGroup>
    <!-- netstandard2.0 so the package doesn't pin its consumers to a framework version. The
         generated parser is plain C# with no modern-runtime needs, and it means this project
         still builds on an older SDK than the CLI solution targets. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Everything compiled here is either generated by ANTLR or vendored unmodified from
         upstream, so the analysis/nullable discipline the CLI solution enforces has nothing to
         act on but ~300k lines nobody hand-edits. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SyncSql.Grammar.PlSql</PackageId>
    <!-- Versioned independently of the CLI (cli/Directory.Build.props): this package only changes
         when the grammar does. Bump it here, publish, then bump $(PlSqlGrammarVersion) in
         cli/src/SyncSql.Lineage.Oracle/SyncSql.Lineage.Oracle.csproj to pick the new one up. -->
    <Version>1.0.0</Version>
    <Authors>SyncSQL</Authors>
    <Company>SyncSQL</Company>
    <Description>PL/SQL lexer and parser for SyncSQL's Oracle lineage analysis, generated with ANTLR4 from the antlr/grammars-v4 sql/plsql grammar. Prebuilt so that consuming projects need no Java toolchain.</Description>
    <RepositoryUrl>https://github.com/cangelosilima/SyncSQL</RepositoryUrl>
    <!-- The grammar this is generated from is Apache-2.0 (Grammar/NOTICE.md, Grammar/LICENSE.txt),
         and generated code inherits it. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships in the package so the upstream attribution travels with the generated code. -->
    <None Include="Grammar\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="Grammar\NOTICE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="$(AntlrVersion)" />
    <!-- Build-time only: generates+compiles PlSqlLexer/PlSqlParser from Grammar/*.g4 as part of
         `dotnet build` (needs a `java` on PATH - see Grammar/NOTICE.md). Nothing generated is
         committed; PrivateAssets keeps this tool out of the published package's dependency list. -->
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- No <Package> (namespace) set: PlSqlLexerBase/PlSqlParserBase are vendored unmodified from
       upstream and reference the generated PlSqlLexer/PlSqlParser types unqualified from the global
       namespace, so the generated code needs to land in the global namespace too - matches how the
       upstream grammar's own C# target is built, and how SyncSql.Lineage.Oracle already consumed
       these types when they were generated in-place. -->
  <!-- AntlrToolJar/AntlrToolJarDownloadDir/JavaExec are set as item metadata rather than through an
       ItemDefinitionGroup: Antlr4BuildTasks' own .targets is imported after this project body and
       its ItemDefinitionGroup would otherwise reset them back to the defaults. -->
  <ItemGroup>
    <Antlr4 Include="Grammar\PlSqlLexer.g4">
      <AntlrToolJar>$(AntlrToolJar)</AntlrToolJar>
      <AntlrToolJarDownloadDir>$(AntlrToolJarDir)</AntlrToolJarDownloadDir>
      <JavaExec>$(AntlrJavaExec)</JavaExec>
    </Antlr4>
    <Antlr4 Include="Grammar\PlSqlParser.g4">
      <Visitor>true</Visitor>
      <Listener>false</Listener>
      <AntlrToolJar>$(AntlrToolJar)</AntlrToolJar>
      <AntlrToolJarDownloadDir>$(AntlrToolJarDir)</AntlrToolJarDownloadDir>
      <JavaExec>$(AntlrJavaExec)</JavaExec>
    </Antlr4>
  </ItemGroup>

</Project>
