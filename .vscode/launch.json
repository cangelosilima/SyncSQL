{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI (SyncSql.Cli)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "cli: build",
      "program": "${workspaceFolder}/cli/src/SyncSql.Cli/bin/Debug/net10.0/SyncSql.Cli.dll",
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Site (Vite dev server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/site/src"
    }
  ]
}
