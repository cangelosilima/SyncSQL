<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[SyncSql.*]*</Include>
          <Exclude>[*.Tests]*,[*.IntegrationTests]*,[SyncSql.Grammar.*]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**,**/grammar/**</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
