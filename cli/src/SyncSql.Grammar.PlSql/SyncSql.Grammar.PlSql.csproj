<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The generated C# lexer/parser is intentionally committed under the repository's grammar/
         directory. Building this project is ordinary C# compilation: no Java runtime, ANTLR tool
         jar, code-generation task, private package feed, or network access is required. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>SyncSql.Grammar.PlSql</PackageId>
    <Description>Oracle SQL and PL/SQL lexer, parser, and visitor generated with ANTLR 4.13.1. Targets .NET Standard 2.0.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oracle;sql;plsql;antlr;parser;grammar</PackageTags>
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\grammar\src\SyncSql.Grammar.PlSql\Grammar\PlSqlLexerBase.cs"
             Link="Grammar\PlSqlLexerBase.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
    <Compile Include="..\..\..\grammar\src\SyncSql.Grammar.PlSql\Grammar\PlSqlParserBase.cs"
             Link="Grammar\PlSqlParserBase.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
    <Compile Include="..\..\..\grammar\src\SyncSql.Grammar.PlSql\Generated\*.cs"
             Link="Generated\%(Filename)%(Extension)">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime only. The parser generator is not a build dependency. -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <None Include="../../../grammar/README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../grammar/src/SyncSql.Grammar.PlSql/Grammar/NOTICE.md" Pack="true" PackagePath="NOTICE.md" />
    <None Include="../../../grammar/src/SyncSql.Grammar.PlSql/Grammar/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>

</Project>
