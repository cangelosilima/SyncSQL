<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SyncSql.Core\SyncSql.Core.csproj" />
    <ProjectReference Include="..\SyncSql.Extraction.MsSql\SyncSql.Extraction.MsSql.csproj" />
    <ProjectReference Include="..\SyncSql.Extraction.Oracle\SyncSql.Extraction.Oracle.csproj" />
    <ProjectReference Include="..\SyncSql.Lineage.MsSql\SyncSql.Lineage.MsSql.csproj" />
    <ProjectReference Include="..\SyncSql.Lineage.Oracle\SyncSql.Lineage.Oracle.csproj" />
    <ProjectReference Include="..\SyncSql.Catalog\SyncSql.Catalog.csproj" />
    <ProjectReference Include="..\SyncSql.Git\SyncSql.Git.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Published as a dotnet global tool ("dotnet tool install", global scope) rather than a
       self-contained executable - see cli/docs/cli.md for install instructions. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>syncsql</ToolCommandName>
    <PackageId>SyncSql.Cli</PackageId>
    <Description>Extraction, lineage, and catalog building for a fleet of MSSQL/Oracle servers - the syncsql CLI.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
