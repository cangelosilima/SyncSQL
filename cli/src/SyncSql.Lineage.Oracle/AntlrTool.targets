<Project>

  <!--
    Resolving the ANTLR4 tool jar for this project's build-time codegen.

    Antlr4BuildTasks runs the *Java* ANTLR4 tool over Grammar/*.g4. It doesn't ship that
    tool: by default it probes `~/.m2`, then downloads from antlr.org and Maven Central. On
    a build agent (or a corporate network) that can't reach either host, that probe ends in

        Went through the complete probe list looking for an Antlr4 tool jar,
        but could not find anything. Fail!

    which says nothing about what to do next. So we resolve the jar ourselves - one explicit
    path, one explicit URL, both overridable - and hand Antlr4BuildTasks the finished path via
    the <Antlr4> items' AntlrToolJar metadata, which short-circuits its probe entirely.

    Overrides (each is an MSBuild property, so an environment variable of the same name works
    too, as does `dotnet build -p:<name>=<value>`):

      AntlrToolJar     Full path to an antlr4-<version>-complete.jar you already have.
                       Set this when the machine has no internet access at all.
      AntlrToolJarUrl  Where to download it from - point it at a Nexus/Artifactory mirror
                       when Maven Central is blocked.
      AntlrToolJarDir  Where the downloaded jar is cached. Defaults to ~/.m2, which is also
                       where Antlr4BuildTasks itself caches, so an already-downloaded jar is
                       picked up rather than fetched twice.
      AntlrJavaExec    Passed through as the <Antlr4> JavaExec metadata. Defaults to `PATH`
                       (require a JRE on PATH); use `PATH;DOWNLOAD` to let Antlr4BuildTasks
                       download a JRE from adoptium instead.
  -->

  <PropertyGroup>
    <!-- The Java tool's version has to match the Antlr4.Runtime.Standard package reference -
         Antlr4BuildTasks derives which tool version it wants from that package. $(AntlrVersion)
         is set in the .csproj and is the single source of truth for both. -->
    <AntlrToolJarFileName>antlr4-$(AntlrVersion)-complete.jar</AntlrToolJarFileName>

    <_AntlrHomeDir Condition="'$(OS)' == 'Windows_NT'">$(UserProfile)</_AntlrHomeDir>
    <_AntlrHomeDir Condition="'$(OS)' != 'Windows_NT'">$(HOME)</_AntlrHomeDir>

    <AntlrToolJarDir Condition="'$(AntlrToolJarDir)' == ''">$(_AntlrHomeDir)/.m2</AntlrToolJarDir>
    <AntlrToolJarDir>$([MSBuild]::NormalizeDirectory('$(AntlrToolJarDir)'))</AntlrToolJarDir>

    <AntlrToolJar Condition="'$(AntlrToolJar)' == ''">$([MSBuild]::NormalizePath('$(AntlrToolJarDir)', '$(AntlrToolJarFileName)'))</AntlrToolJar>

    <AntlrToolJarUrl Condition="'$(AntlrToolJarUrl)' == ''">https://repo1.maven.org/maven2/org/antlr/antlr4/$(AntlrVersion)/$(AntlrToolJarFileName)</AntlrToolJarUrl>

    <AntlrJavaExec Condition="'$(AntlrJavaExec)' == ''">PATH</AntlrJavaExec>
  </PropertyGroup>

  <!-- Fetch the jar before Antlr4BuildTasks needs it. BeforeTargets (rather than appending to
       $(Antlr4CompileDependsOn)) because the package's .targets is imported after this project
       body and would overwrite that property. -->
  <Target Name="EnsureAntlrToolJar"
          BeforeTargets="Antlr4Compile"
          Condition="!Exists('$(AntlrToolJar)')">

    <Message Importance="high"
             Text="ANTLR4 tool jar not found at '$(AntlrToolJar)' - downloading it from $(AntlrToolJarUrl)." />

    <MakeDir Directories="$(AntlrToolJarDir)" />

    <DownloadFile SourceUrl="$(AntlrToolJarUrl)"
                  DestinationFolder="$(AntlrToolJarDir)"
                  DestinationFileName="$(AntlrToolJarFileName)"
                  Retries="3"
                  RetryDelayMilliseconds="2000"
                  ContinueOnError="true" />

    <Error Condition="!Exists('$(AntlrToolJar)')"
           Text="Could not obtain the ANTLR4 $(AntlrVersion) tool jar, which this project needs to generate the PL/SQL lexer/parser from Grammar/*.g4.%0A%0ATried to download: $(AntlrToolJarUrl)%0AExpected it at:    $(AntlrToolJar)%0A%0AIf this machine can't reach Maven Central, do one of:%0A  * download antlr4-$(AntlrVersion)-complete.jar elsewhere, drop it at the path above, and rebuild;%0A  * point the build at a copy you already have:  dotnet build -p:AntlrToolJar=/path/to/antlr4-$(AntlrVersion)-complete.jar%0A  * point it at an internal mirror:               dotnet build -p:AntlrToolJarUrl=https://nexus.example/.../antlr4-$(AntlrVersion)-complete.jar%0AEach of those also works as an environment variable of the same name." />
  </Target>

  <!-- A missing JRE fails much further in, inside the ANTLR task, with a message that doesn't
       name the fix either. Check it up front, but only on the build that actually runs codegen
       (and never during Visual Studio's design-time builds, which are frequent and shouldn't
       pay for spawning java). -->
  <Target Name="CheckAntlrJavaRuntime"
          BeforeTargets="Antlr4Compile"
          Condition="'$(AntlrJavaExec)' == 'PATH' and '$(DesignTimeBuild)' != 'true' and !Exists('$(Antlr4ToCompileListFile)')">

    <Exec Command="java -version"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_AntlrJavaExitCode" />
    </Exec>

    <Error Condition="'$(_AntlrJavaExitCode)' != '0'"
           Text="No working `java` on PATH. The ANTLR4 tool is a Java program, and this project generates its PL/SQL lexer/parser from Grammar/*.g4 on every build, so a JRE (11 or newer) is a build prerequisite.%0A%0AInstall one:%0A  Debian/Ubuntu  apt-get install -y default-jre-headless%0A  macOS          brew install openjdk%0A  Windows        winget install Microsoft.OpenJDK.21%0A%0AOr let Antlr4BuildTasks fetch its own JRE (needs access to github.com):  dotnet build -p:AntlrJavaExec=&quot;PATH;DOWNLOAD&quot;" />
  </Target>

</Project>
