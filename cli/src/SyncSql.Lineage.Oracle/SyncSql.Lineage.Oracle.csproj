<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single source of truth for the ANTLR version: the runtime package below and the Java
         tool jar AntlrTool.targets resolves have to be the same version, or Antlr4BuildTasks
         refuses to run. Declared before the import below, which reads it. -->
    <AntlrVersion>4.13.1</AntlrVersion>
  </PropertyGroup>

  <!-- Resolves the ANTLR4 tool jar (and checks for a JRE) before the codegen below runs.
       See that file's header for the overrides available on an offline/mirrored build. -->
  <Import Project="AntlrTool.targets" />

  <ItemGroup>
    <ProjectReference Include="..\SyncSql.Core\SyncSql.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="$(AntlrVersion)" />
    <!-- Build-time only: generates+compiles PlSqlLexer/PlSqlParser from Grammar/*.g4 as part of
         `dotnet build` (needs a `java` on PATH - see Grammar/NOTICE.md). Nothing generated is
         committed; PrivateAssets keeps this tool out of this project's own published dependency list. -->
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- No <Package> (namespace) set: PlSqlLexerBase/PlSqlParserBase are vendored unmodified from
       upstream and reference the generated PlSqlLexer/PlSqlParser types unqualified from the global
       namespace, so the generated code needs to land in the global namespace too - matches how the
       upstream grammar's own C# target is built. -->
  <!-- AntlrToolJar/AntlrToolJarDownloadDir/JavaExec are set as item metadata rather than through an
       ItemDefinitionGroup: Antlr4BuildTasks' own .targets is imported after this project body and
       its ItemDefinitionGroup would otherwise reset them back to the defaults. -->
  <ItemGroup>
    <Antlr4 Include="Grammar\PlSqlLexer.g4">
      <AntlrToolJar>$(AntlrToolJar)</AntlrToolJar>
      <AntlrToolJarDownloadDir>$(AntlrToolJarDir)</AntlrToolJarDownloadDir>
      <JavaExec>$(AntlrJavaExec)</JavaExec>
    </Antlr4>
    <Antlr4 Include="Grammar\PlSqlParser.g4">
      <Visitor>true</Visitor>
      <Listener>false</Listener>
      <AntlrToolJar>$(AntlrToolJar)</AntlrToolJar>
      <AntlrToolJarDownloadDir>$(AntlrToolJarDir)</AntlrToolJarDownloadDir>
      <JavaExec>$(AntlrJavaExec)</JavaExec>
    </Antlr4>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The vendored grammar/generated parser predates C# nullable annotations and isn't ours to
         annotate - enforcing it project-wide would just fight ~300k lines of generated code we don't
         hand-edit. The hand-written analyzer/visitor in this project still follows nullable discipline
         by convention. -->
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
